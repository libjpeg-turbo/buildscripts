export CFLAGS=-Wall

CMAKE_BUILD_TYPE=Release

if [ "$1" = "-g" ]; then
	CMAKE_BUILD_TYPE=RelWithDebInfo
	shift
fi

LDFLAGS="-Wl,-z,relro -Wl,-z,now" \
cmake -G"Ninja" -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
	-DCMAKE_POSITION_INDEPENDENT_CODE=1 -DPKGNAME=libjpeg-turbo-official \
	-DREQUIRE_SIMD=1 -DWITH_JNA=~/.jna/$(uname -s)-$(uname -m)/jna.jar \
	-DCMAKE_JAVA_COMPILE_FLAGS='-target 1.8 -source 1.8 -Xlint:all,-serial' \
	.. ${1+"$@"}
